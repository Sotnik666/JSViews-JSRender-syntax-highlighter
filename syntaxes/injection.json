{
	"scopeName": "jsviews.injection",
	"injectionSelector": "L:text.html.basic, L:text.html.derivative, L:text.html -comment.block -comment.line",
	"patterns": [
		{
			"include": "#jsviews-comment"
		},
		{
			"include": "#jsviews-expression-short"
		},
		{
			"include": "#jsviews-tag"
		},
		{
			"include": "#jsviews-script"
		}
	],
	"repository": {
		"jsviews-comment": {
			"name": "comment.block.jsviews",
			"match": "(\\{\\{!--)(.*?)(--\\}\\})",
			"captures": {
				"1": {
					"name": "punctuation.definition.comment.jsviews"
				},
				"2": {
					"name": "comment.block.jsviews"
				},
				"3": {
					"name": "punctuation.definition.comment.jsviews"
				}
			}
		},
		"jsviews-expression-short": {
			"name": "meta.embedded.expression.jsviews",
			"match": "(\\{\\^?\\{)([*:|>])(.*?)(/?\\}\\})",
			"captures": {
				"1": {
					"name": "punctuation.section.embedded.begin.jsviews"
				},
				"2": {
					"name": "keyword.operator.jsviews"
				},
				"3": {
					"name": "source.js.embedded.jsviews",
					"patterns": [
						{
							"include": "#jsviews-property"
						},
						{
							"include": "source.js"
						}
					]
				},
				"4": {
					"name": "punctuation.section.embedded.end.jsviews"
				}
			}
		},
		"jsviews-tag": {
			"name": "meta.tag.jsviews",
			"begin": "(\\{\\^?\\{)(/?)([A-Za-z_][\\w-]*)",
			"beginCaptures": {
				"1": {
					"name": "punctuation.definition.tag.begin.jsviews"
				},
				"2": {
					"name": "punctuation.definition.tag.closing.jsviews"
				},
				"3": {
					"name": "entity.name.tag.jsviews keyword.control.tag.jsviews"
				}
			},
			"end": "(/?)(\\}\\})",
			"endCaptures": {
				"1": {
					"name": "punctuation.definition.tag.self-closing.jsviews"
				},
				"2": {
					"name": "punctuation.definition.tag.end.jsviews"
				}
			},
			"patterns": [
				{
					"include": "#jsviews-property"
				},
				{
					"match": "[^\\s/}]+",
					"name": "source.js.embedded.jsviews",
					"patterns": [
						{
							"include": "source.js"
						}
					]
				}
			]
		},
		"jsviews-property": {
			"match": "([A-Za-z_~][\\w-]*)(=)(?:(\"[^\"]*\")|('[^']*')|([^\\s/}]+))",
			"name": "meta.attribute.jsviews",
			"captures": {
				"1": {
					"name": "entity.other.attribute-name.jsviews"
				},
				"2": {
					"name": "punctuation.separator.key-value.jsviews"
				},
				"3": {
					"name": "string.quoted.double.html"
				},
				"4": {
					"name": "string.quoted.single.html"
				},
				"5": {
					"name": "string.unquoted.html",
					"patterns": [
						{
							"include": "source.js"
						}
					]
				}
			}
		},
		"jsviews-script": {
			"name": "meta.tag.script.jsviews",
			"begin": "(<)(script)\\b(?=[^>]*type\\s*=\\s*[\"']text/x-jsrender[\"'])([^>]*)(>)",
			"beginCaptures": {
				"1": {
					"name": "punctuation.definition.tag.begin.html"
				},
				"2": {
					"name": "entity.name.tag.html"
				},
				"3": {
					"patterns": [
						{
							"match": "\\b([A-Za-z_:][\\w:.-]*)(=)(\"[^\"]*\"|'[^']*')",
							"captures": {
								"1": {
									"name": "entity.other.attribute-name.html"
								},
								"2": {
									"name": "punctuation.separator.key-value.html"
								},
								"3": {
									"name": "string.quoted.html"
								}
							}
						}
					]
				},
				"4": {
					"name": "punctuation.definition.tag.end.html"
				}
			},
			"end": "(</)(script)(>)",
			"endCaptures": {
				"1": {
					"name": "punctuation.definition.tag.begin.html"
				},
				"2": {
					"name": "entity.name.tag.html"
				},
				"3": {
					"name": "punctuation.definition.tag.end.html"
				}
			},
			"patterns": [
				{
					"include": "text.html.basic"
				}
			]
		}
	}
}
